# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: ot-rcp-cpc_MG21
label: ot-rcp-cpc_MG21
description: |
  This is a simple OpenThread RCP application. This is equivalent to the ot-rcp application in the OpenThread GitHub repo.
category: OpenThread Examples
filter:
- name: Device Type
  value: [RCP]
- name: Project Difficulty
  value: [Advanced]
- name: Wireless Technology
  value: [Thread]
package: openthread
quality: production
readme:
- {path: README-OT-RCP.md}
- {path: README-OT-RCP.md}
source:
- {path: app.c}
tag: [prebuilt_demo]
include:
- path: .
  file_list:
  - {path: app.h}
sdk: {id: simplicity_sdk, version: 2025.6.2}
toolchain_settings: []
component:
- {id: EFR32MG21A020F1024IM32}
- {id: bootloader_interface}
- {id: brd4002a}
- {id: brd4180a}
- {id: clock_manager}
- instance: [vcom]
  id: cpc_secondary_driver_uart_usart
- {id: ot_crash_handler}
- {id: ot_ncp_cpc}
- {id: ot_reset_utils}
- {id: ot_stack_rcp}
- {id: rail_util_pti}
- {id: sl_main}
- {id: toolchain_gcc_lto}
configuration:
- condition: [sl_main]
  name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
  value: '2752'
- {name: SL_BOARD_ENABLE_VCOM, value: '1'}
- condition: [iostream_usart]
  name: SL_IOSTREAM_USART_VCOM_BAUDRATE
  value: '460800'
- condition: [iostream_eusart]
  name: SL_IOSTREAM_EUSART_VCOM_BAUDRATE
  value: '460800'
- {name: OPENTHREAD_CONFIG_HEAP_EXTERNAL_ENABLE, value: '0'}
- condition: [ot_rtt_log]
  name: OPENTHREAD_CONFIG_LOG_OUTPUT
  value: OPENTHREAD_CONFIG_LOG_OUTPUT_PLATFORM_DEFINED
- condition: [ot_rtt_log]
  name: BUFFER_SIZE_UP
  value: '768'
- condition: [ot_rtt_log]
  name: BUFFER_SIZE_DOWN
  value: '0'
- {name: CIRCULAR_QUEUE_LEN_MAX, value: '16'}
- condition: [iostream_usart]
  name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
  value: usartHwFlowControlCtsAndRts
- condition: [iostream_eusart]
  name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
  value: SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS
- {name: SL_OPENTHREAD_STACK_TASK_MEM_SIZE, value: '4608'}
- condition: [kernel]
  name: SL_STACK_SIZE
  value: '2048'
ui_hints:
  highlight:
  - {path: ./README-OT-RCP.md, focus: true}

